<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/backgroundEditingToolbar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:elevation="16dp"
    android:orientation="vertical"
    android:paddingTop="12dp"
    android:paddingBottom="24dp"
    android:visibility="gone">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingBottom="16dp">

        <ImageButton
            android:id="@+id/btnBackFromBackground"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_close_24"
            app:tint="@color/activeTool" />

        <TextView
            android:id="@+id/tvTitleBackground"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:fontFamily="sans-serif-medium"
            android:text="Canvas Background"
            android:textColor="@color/textColor"
            android:textSize="18sp" />

        <ImageButton
            android:id="@+id/btnBackgroundDone"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_check_24"
            app:tint="@color/activeTool" />
    </RelativeLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:paddingHorizontal="24dp">

            <!-- Color Button -->
            <LinearLayout
                android:id="@+id/btnBackgroundColor"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:gravity="center"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_aspect_ratio_item">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_canvas_color_24"
                        app:tint="@color/iconSecondary" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Color"
                    android:textColor="@color/toolTextInactive"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Blur Button -->
            <LinearLayout
                android:id="@+id/btnBackgroundBlur"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:gravity="center"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_aspect_ratio_item">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_opacity_24"
                        app:tint="@color/iconSecondary" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Blur"
                    android:textColor="@color/toolTextInactive"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Image Button -->
            <LinearLayout
                android:id="@+id/btnBackgroundImage"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_aspect_ratio_item">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_image_24"
                        app:tint="@color/iconSecondary" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Image"
                    android:textColor="@color/toolTextInactive"
                    android:textSize="11sp" />
            </LinearLayout>

        </LinearLayout>
    </HorizontalScrollView>

    <!-- CapCut-style blur strengths: tapping Blur shows four options, the
         same background with increasing blur. The icon alpha hints at the
         strength; the gold highlight marks the active one. -->
    <LinearLayout
        android:id="@+id/blurStrengthRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="12dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/btnBlurLight"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/bgBlurLight"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_aspect_ratio_item">

                <ImageView
                    android:id="@+id/icBlurLight"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:alpha="0.4"
                    android:src="@drawable/ic_opacity_24"
                    app:tint="@color/iconSecondary" />
            </FrameLayout>

            <TextView
                android:id="@+id/txtBlurLight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/str_blur_light"
                android:textColor="@color/toolTextInactive"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnBlurMedium"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/bgBlurMedium"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_aspect_ratio_item">

                <ImageView
                    android:id="@+id/icBlurMedium"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:alpha="0.6"
                    android:src="@drawable/ic_opacity_24"
                    app:tint="@color/iconSecondary" />
            </FrameLayout>

            <TextView
                android:id="@+id/txtBlurMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/str_blur_medium"
                android:textColor="@color/toolTextInactive"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnBlurStrong"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/bgBlurStrong"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_aspect_ratio_item">

                <ImageView
                    android:id="@+id/icBlurStrong"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:alpha="0.8"
                    android:src="@drawable/ic_opacity_24"
                    app:tint="@color/iconSecondary" />
            </FrameLayout>

            <TextView
                android:id="@+id/txtBlurStrong"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/str_blur_strong"
                android:textColor="@color/toolTextInactive"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnBlurMax"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/bgBlurMax"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_aspect_ratio_item">

                <ImageView
                    android:id="@+id/icBlurMax"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:alpha="1.0"
                    android:src="@drawable/ic_opacity_24"
                    app:tint="@color/iconSecondary" />
            </FrameLayout>

            <TextView
                android:id="@+id/txtBlurMax"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/str_blur_max"
                android:textColor="@color/toolTextInactive"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
