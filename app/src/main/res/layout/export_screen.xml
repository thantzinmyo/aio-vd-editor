<?xml version="1.0" encoding="utf-8"?>
<!-- CapCut-style export screen: full-screen black, the video frame with a
     big percentage over it, a thin progress bar, and the encoded time. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/exportScreen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000"
    android:visibility="gone"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- Top bar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp">

            <ImageButton
                android:id="@+id/btnExportBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cancel"
                android:src="@drawable/ic_back_24"
                app:tint="#FFFFFFFF" />

            <TextView
                android:id="@+id/tvExportTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:fontFamily="sans-serif-medium"
                android:text="@string/str_exporting"
                android:textColor="#FFFFFFFF"
                android:textSize="18sp" />
        </RelativeLayout>

        <!-- Subtitle -->
        <TextView
            android:id="@+id/tvExportMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/str_please_dont_lock_screen"
            android:textColor="#FFAAAAAA"
            android:textSize="13sp" />

        <!-- Video preview with the percentage over it, like CapCut -->
        <FrameLayout
            android:id="@+id/exportPreviewFrame"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp">

            <ImageView
                android:id="@+id/ivExportPreview"
                android:layout_width="280dp"
                android:layout_height="420dp"
                android:background="#FF111111"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/tvExportPercentage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="sans-serif-bold"
                android:text="0.0%"
                android:textColor="#FFFFFFFF"
                android:textSize="32sp" />

            <ProgressBar
                android:id="@+id/exportProgressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_gravity="bottom"
                android:indeterminate="false"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/linear_progress_white" />
        </FrameLayout>

        <!-- Encoded time readout (was the only progress sign for long videos) -->
        <TextView
            android:id="@+id/tvExportEncoded"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textColor="#FFAAAAAA"
            android:textSize="13sp" />

        <!-- Cancel (CapCut has no cancel here, but stopping a 20-minute
             export must stay possible) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelExport"
            android:layout_width="160dp"
            android:layout_height="44dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/surfaceVariant"
            android:fontFamily="sans-serif-medium"
            android:insetBottom="0dp"
            android:insetTop="0dp"
            android:text="@string/cancel"
            android:textColor="@color/textColor"
            android:textSize="14sp"
            app:cornerRadius="22dp"
            app:strokeWidth="0dp" />

    </LinearLayout>
</FrameLayout>
